{
  "title": "AgentTemplate 工程观测",
  "uid": "agent-template",
  "schemaVersion": 41,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API 请求速率",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(agent_http_requests_total[5m])) by (route)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API 延迟",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_http_duration_seconds_bucket[5m])) by (le,route))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "运行状态",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(agent_runs_total[5m])) by (framework,status)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "模型调用",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(agent_model_calls_total[5m])) by (provider,status)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "工具调用",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(agent_tool_calls_total[5m])) by (tool,status)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "检索耗时",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum(rate(agent_retrieval_seconds_bucket[5m])) by (le))"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}