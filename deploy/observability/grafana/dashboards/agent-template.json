{
  "title": "AgentTemplate 工程观测",
  "uid": "agent-template",
  "schemaVersion": 41,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API 请求速率",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(agent_http_requests_total[5m])) by (route)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API 延迟 P95",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_http_request_duration_seconds_bucket[5m])) by (le,route))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "运行状态统计",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(agent_runs_total[5m])) by (agent,status)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "运行耗时 P95",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_run_duration_seconds_bucket[5m])) by (le,agent))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "队列等待时间 P95",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_run_queue_wait_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM 调用速率",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(agent_llm_requests_total[5m])) by (model,provider,status)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM 调用耗时 P95",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_llm_request_duration_seconds_bucket[5m])) by (le,model,provider))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM 首 Token 延迟 P95",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_llm_time_to_first_token_seconds_bucket[5m])) by (le,model,provider))"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "LLM Token 用量",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(agent_llm_tokens_total[5m])) by (model,type)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "LLM 费用速率",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(agent_llm_cost_total[5m])) by (model)"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "工具调用统计",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(agent_tool_calls_total[5m])) by (tool,status)"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "工具调用耗时 P95",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_tool_duration_seconds_bucket[5m])) by (le,tool))"
        }
      ]
    },
    {
      "id": 13,
      "type": "gauge",
      "title": "数据库连接池使用率",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "agent_db_pool_connections{state=\"in_use\"} / (agent_db_pool_connections{state=\"in_use\"} + agent_db_pool_connections{state=\"idle\"})"
        }
      ],
      "options": {
        "thresholds": {
          "steps": [
            {"value": 0, "color": "green"},
            {"value": 0.7, "color": "yellow"},
            {"value": 0.9, "color": "red"}
          ]
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "数据库连接池状态",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "agent_db_pool_connections{state=\"in_use\"}",
          "legendFormat": "使用中"
        },
        {
          "expr": "agent_db_pool_connections{state=\"idle\"}",
          "legendFormat": "空闲"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s"
}
